# Build dependencies and run the real installer inside an isolated Linux image.
FROM node:24-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pil glslang-tools spirv-tools git curl ca-certificates tar xz-utils openssh-client fonts-dejavu-core iproute2 iputils-ping xdg-utils && rm -rf /var/lib/apt/lists/*
COPY . /source
RUN /source/install.sh --prefix /opt/iz2s --no-system-packages --no-desktop && rm -rf /source && useradd --create-home --uid 10001 preview && chown -R preview:preview /opt/iz2s
USER 10001:10001
WORKDIR /opt/iz2s
# Resolve immutable module snapshots while the image is writable. The running
# preview has a read-only filesystem and must not need to unpack IZM files.
RUN node -e "require('./core/modules.cjs').list(process.cwd()).then(x=>{if(x.errors.length)throw Error(JSON.stringify(x.errors));console.log('Prepared '+x.modules.length+' module snapshots')}).catch(e=>{console.error(e);process.exitCode=1})"
ENV HB_OPEN_PANEL=0
EXPOSE 39517
CMD ["node", "distribution/container-entry.cjs"]
