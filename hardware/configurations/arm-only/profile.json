{
  "id": "arm-only",
  "name": "ARM PC Only",
  "executionHost": "arm",
  "inputAdapter": "local-gadget",
  "description": "Run this server on the ARM PC; its local USB gadget connects directly to Switch.",
  "fields": [
    {
      "key": "consoleHost",
      "label": "Server IPv4 address (empty = automatic)",
      "type": "text",
      "default": ""
    },
    {
      "key": "consoleAddress",
      "label": "Switch LAN IPv4 address (optional)",
      "type": "text",
      "default": ""
    },
    {
      "key": "consoleWifiAddress",
      "label": "Switch Wi-Fi IPv4 address (optional)",
      "type": "text",
      "default": ""
    },
    {
      "key": "hidDevice",
      "label": "USB HID gadget device",
      "type": "text",
      "default": "/dev/hidg0"
    }
  ],
  "format": "izlauncher.profile",
  "apiVersion": 1,
  "version": "0.16.0-rc.1",
  "entry": "entry.cjs",
  "platforms": [
    "linux-x64",
    "linux-arm64"
  ],
  "nodes": [
    {
      "id": "host",
      "device": "arm-host-gadget",
      "roles": [
        "server",
        "input"
      ]
    },
    {
      "id": "console",
      "device": "switch2",
      "roles": [
        "console"
      ]
    }
  ],
  "links": [
    {
      "id": "control",
      "from": "host",
      "to": "console",
      "type": "usb-hid"
    },
    {
      "id": "stream",
      "from": "host",
      "to": "console",
      "type": "network"
    }
  ],
  "ui": {
    "combined": true,
    "checks": [
      {
        "id": "server",
        "label": "ARM PC \u00b7 server + input",
        "icon": "i-server"
      },
      {
        "id": "usb",
        "label": "ARM Type C - Switch",
        "icon": "i-usb"
      },
      {
        "id": "lan",
        "label": "Console",
        "icon": "i-switch"
      }
    ]
  },
  "order": 1,
  "selectable": false,
  "unavailableReason": "Coming soon"
}
