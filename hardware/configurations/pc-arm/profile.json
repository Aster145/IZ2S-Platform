{
  "id": "pc-arm",
  "name": "PC + ARM PC",
  "executionHost": "pc",
  "inputAdapter": "ssh-gadget",
  "description": "Server and applications on this PC; USB keyboard on the ARM PC.",
  "fields": [
    {
      "key": "consoleHost",
      "label": "Server IPv4 address (empty = automatic)",
      "type": "text",
      "default": ""
    },
    {
      "key": "consoleAddress",
      "label": "Switch LAN IPv4 address (optional)",
      "type": "text",
      "default": ""
    },
    {
      "key": "consoleWifiAddress",
      "label": "Switch Wi-Fi IPv4 address (optional)",
      "type": "text",
      "default": ""
    },
    {
      "key": "armAddress",
      "label": "ARM PC IPv4 address (optional)",
      "type": "text",
      "default": ""
    },
    {
      "key": "deviceFolder",
      "label": "ARM input module directory",
      "type": "text",
      "default": "/opt/iz2s/arm-input"
    }
  ],
  "format": "izlauncher.profile",
  "apiVersion": 1,
  "version": "0.16.0-rc.1",
  "entry": "entry.cjs",
  "platforms": [
    "linux-x64",
    "linux-arm64"
  ],
  "nodes": [
    {
      "id": "server",
      "device": "linux-host",
      "roles": [
        "server"
      ]
    },
    {
      "id": "input",
      "device": "arm-gadget",
      "roles": [
        "input"
      ]
    },
    {
      "id": "console",
      "device": "switch2",
      "roles": [
        "console"
      ]
    }
  ],
  "links": [
    {
      "id": "control",
      "from": "input",
      "to": "console",
      "type": "usb-hid"
    },
    {
      "id": "stream",
      "from": "server",
      "to": "console",
      "type": "network"
    }
  ],
  "ui": {
    "combined": false,
    "checks": [
      {
        "id": "server",
        "label": "Server",
        "icon": "i-server"
      },
      {
        "id": "arm",
        "label": "ARM PC \u00b7 input",
        "icon": "i-arm"
      },
      {
        "id": "usb",
        "label": "ARM Type C - Switch",
        "icon": "i-usb"
      },
      {
        "id": "lan",
        "label": "Console",
        "icon": "i-switch"
      }
    ]
  },
  "order": 0,
  "selectable": true,
  "unavailableReason": ""
}
