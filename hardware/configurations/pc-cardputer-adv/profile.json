{
  "id": "pc-cardputer-adv",
  "name": "PC + Cardputer ADV",
  "executionHost": "pc",
  "inputAdapter": "kprox-http",
  "description": "Server on this PC; Cardputer ADV runs KProx and sends USB keyboard input.",
  "fields": [
    {
      "key": "consoleHost",
      "label": "Server IPv4 address (empty = automatic)",
      "type": "text",
      "default": ""
    },
    {
      "key": "consoleAddress",
      "label": "Switch LAN IPv4 address (optional)",
      "type": "text",
      "default": ""
    },
    {
      "key": "consoleWifiAddress",
      "label": "Switch Wi-Fi IPv4 address (optional)",
      "type": "text",
      "default": ""
    },
    {
      "key": "cardputerEndpoint",
      "label": "Cardputer KProx HTTP address",
      "type": "text",
      "default": ""
    },
    {
      "key": "cardputerApiKeyEnv",
      "label": "Environment variable containing the KProx API key",
      "type": "text",
      "default": "IZ15_CARDPUTER_API_KEY"
    },
    {
      "key": "cardputerFirmware",
      "label": "Installed firmware",
      "type": "select",
      "default": "",
      "options": [
        {
          "value": "",
          "label": "Not configured"
        },
        {
          "value": "kprox",
          "label": "KProx (USB keyboard mode)"
        }
      ]
    },
    {
      "key": "cardputerCapsLock",
      "label": "Switch keyboard Caps Lock state",
      "type": "select",
      "default": "unknown",
      "options": [
        {
          "value": "unknown",
          "label": "Not confirmed"
        },
        {
          "value": "off",
          "label": "Off"
        },
        {
          "value": "on",
          "label": "On"
        }
      ]
    }
  ],
  "format": "izlauncher.profile",
  "apiVersion": 1,
  "version": "0.16.0-rc.1",
  "entry": "entry.cjs",
  "platforms": [
    "linux-x64",
    "linux-arm64"
  ],
  "nodes": [
    {
      "id": "server",
      "device": "linux-host",
      "roles": [
        "server"
      ]
    },
    {
      "id": "input",
      "device": "cardputer-adv",
      "roles": [
        "input"
      ]
    },
    {
      "id": "console",
      "device": "switch2",
      "roles": [
        "console"
      ]
    }
  ],
  "links": [
    {
      "id": "control",
      "from": "input",
      "to": "console",
      "type": "usb-hid"
    },
    {
      "id": "stream",
      "from": "server",
      "to": "console",
      "type": "network"
    }
  ],
  "ui": {
    "combined": false,
    "checks": [
      {
        "id": "server",
        "label": "Server",
        "icon": "i-server"
      },
      {
        "id": "arm",
        "label": "Cardputer ADV · input",
        "icon": "i-arm"
      },
      {
        "id": "usb",
        "label": "USB → Switch",
        "icon": "i-usb"
      },
      {
        "id": "lan",
        "label": "Console",
        "icon": "i-switch"
      }
    ]
  },
  "order": 2,
  "selectable": false,
  "unavailableReason": "Coming soon"
}
