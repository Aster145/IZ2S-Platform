{
  "format": "izlauncher.device",
  "apiVersion": 1,
  "version": "1.0.0",
  "id": "arm-gadget",
  "name": "ARM PC USB gadget",
  "roles": [
    "input"
  ],
  "fields": [
    {
      "key": "armAddress",
      "label": "ARM PC IPv4 address (optional)",
      "type": "text",
      "default": ""
    },
    {
      "key": "deviceFolder",
      "label": "ARM input module directory",
      "type": "text",
      "default": "/opt/iz2s/arm-input"
    },
    {
      "key": "armUser",
      "label": "ARM SSH user (root required for input)",
      "type": "text",
      "default": "root"
    },
    {
      "key": "sshIdentity",
      "label": "SSH private key path (optional; stays on this PC)",
      "type": "text",
      "default": ""
    },
    {
      "key": "sshKnownHosts",
      "label": "SSH known-hosts file (optional)",
      "type": "text",
      "default": ""
    },
    {
      "key": "sshHostKeyAlias",
      "label": "SSH host-key alias (optional)",
      "type": "text",
      "default": ""
    }
  ],
  "transport": {
    "adapter": "ssh-gadget",
    "link": "usb-hid"
  },
  "hostPlatforms": [
    "linux-x64",
    "linux-arm64"
  ],
  "capabilities": [
    "network",
    "usb-keyboard"
  ],
  "inputPackage": "arm-input"
}
