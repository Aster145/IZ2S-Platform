{
  "format": "izlauncher.device",
  "apiVersion": 1,
  "version": "1.0.0",
  "id": "arm-host-gadget",
  "name": "ARM PC: server + USB input",
  "roles": [
    "server",
    "input"
  ],
  "fields": [
    {
      "key": "consoleHost",
      "label": "Server IPv4 address (empty = automatic)",
      "type": "text",
      "default": ""
    },
    {
      "key": "hidDevice",
      "label": "USB HID gadget device",
      "type": "text",
      "default": "/dev/hidg0"
    }
  ],
  "transport": {
    "adapter": "local-gadget",
    "link": "usb-hid"
  },
  "hostPlatforms": [
    "linux-arm64"
  ],
  "capabilities": [
    "network",
    "usb-keyboard"
  ],
  "inputPackage": "arm-input"
}
