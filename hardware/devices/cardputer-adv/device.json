{
  "format": "izlauncher.device",
  "apiVersion": 1,
  "version": "1.0.0",
  "id": "cardputer-adv",
  "name": "Cardputer ADV · KProx",
  "roles": [
    "input"
  ],
  "fields": [
    {
      "key": "cardputerEndpoint",
      "label": "Cardputer KProx HTTP address",
      "type": "text",
      "default": ""
    },
    {
      "key": "cardputerApiKeyEnv",
      "label": "Environment variable containing the KProx API key",
      "type": "text",
      "default": "IZ15_CARDPUTER_API_KEY"
    },
    {
      "key": "cardputerFirmware",
      "label": "Installed firmware",
      "type": "select",
      "default": "",
      "options": [
        {
          "value": "",
          "label": "Not configured"
        },
        {
          "value": "kprox",
          "label": "KProx (USB keyboard mode)"
        }
      ]
    },
    {
      "key": "cardputerCapsLock",
      "label": "Switch keyboard Caps Lock state",
      "type": "select",
      "default": "unknown",
      "options": [
        {
          "value": "unknown",
          "label": "Not confirmed"
        },
        {
          "value": "off",
          "label": "Off"
        },
        {
          "value": "on",
          "label": "On"
        }
      ]
    }
  ],
  "transport": {
    "adapter": "kprox-http",
    "link": "usb-hid"
  },
  "hostPlatforms": [
    "linux-x64",
    "linux-arm64"
  ],
  "capabilities": [
    "network",
    "usb-keyboard"
  ],
  "validator": "settings.cjs"
}
