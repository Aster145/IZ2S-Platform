{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "$id": "urn:izlauncher:profile:1",
  "title": "IZlauncher profile API 1",
  "required": [
    "format",
    "apiVersion",
    "id",
    "name",
    "version",
    "platforms",
    "entry",
    "fields"
  ],
  "properties": {
    "format": {
      "const": "izlauncher.profile"
    },
    "apiVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
    },
    "entry": {
      "type": "string",
      "minLength": 1
    },
    "platforms": {
      "type": "array",
      "items": {
        "enum": [
          "linux-x64",
          "linux-arm64",
          "win32-x64",
          "win32-arm64",
          "darwin-x64",
          "darwin-arm64"
        ]
      }
    },
    "fields": {
      "type": "array"
    }
  }
}
